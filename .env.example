# Backend
PORT=8080
DATABASE_URL=postgres://postgres:password@localhost:5432/webapp?sslmode=disable
FRONTEND_ORIGIN=http://localhost:5173
GCP_PROJECT_ID=your-project-id

# Session (JWT_SECRET must be at least 32 characters)
JWT_SECRET=change-me-to-a-random-64-char-string
COOKIE_SECURE=false

# サインアップの制限（カンマ区切り。大文字と小文字は区別しない）
# 初回ログインで admin にするメールアドレス。未設定なら誰も admin にならない
INITIAL_ADMIN_EMAILS=
# ログインを許可するメールのドメイン（例: example.co.jp）。未設定なら制限しない
ALLOWED_EMAIL_DOMAINS=

# OAuth のリダイレクト URL は、ブラウザが開くフロントのオリジンにする（/api は backend へ転送される）。
# 同じ URL を各プロバイダの管理画面にも登録すること。

# OAuth: Google (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:5173/api/v1/auth/google/callback

# OAuth: GitHub (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:5173/api/v1/auth/github/callback

# OAuth: Microsoft (https://portal.azure.com/#blade/Microsoft_AAD_RegisteredApps)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL=http://localhost:5173/api/v1/auth/microsoft/callback
# サインインを許可する Entra テナントの ID かドメイン。未設定や common ではメールを検証できず、ログインを拒否します
MICROSOFT_TENANT_ID=

# Frontend (Vite): 開発サーバーが /api を転送する先。未設定なら http://localhost:8080
# API_PROXY_TARGET=http://localhost:8080
